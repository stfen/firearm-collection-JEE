################################################################################
# HTTP Client request examples for firearm-collection-JEE User API
# Use in IntelliJ / VS Code REST Client extensions.
# Adjust {{host}} and {{base}} if context root differs. Default (dev mode):
#   Base URL: http://localhost:9080/firearm-collection-JEE/api
# If you configured custom context root (e.g. /firearms) change base accordingly.
################################################################################

@host = localhost:9080
@base = http://{{host}}/firearm-collection-JEE/api
@json = application/json

### List all users
GET {{base}}/users
Accept: {{json}}

### Get user by UUID (replace {{userId}} after creation)
@userId = 9fb90607-54ea-4d8c-a232-aa7296e6ffa3
GET {{base}}/users/{{userId}}
Accept: {{json}}

### Get user by login
GET {{base}}/users/login/admin
Accept: {{json}}

### Check login availability (true if free)
GET {{base}}/users/login/someNewLogin/available
Accept: {{json}}

### Check email availability
GET {{base}}/users/email/test.new@example.com/available
Accept: {{json}}

### List users by role
GET {{base}}/roles/USER/users
Accept: {{json}}

### Create user (POST)
POST {{base}}/users
Content-Type: {{json}}
Accept: {{json}}

{
	"login": "newuser2",
	"email": "newuser2@example.com",
	"birthDate": "1998-05-21",
	"roles": ["USER"]
}

### Capture created user id (manual step)
# After running create, copy its id into @userId variable at the top or here:
# @userId = REPLACE_WITH_RETURNED_ID

### Get created user
GET {{base}}/users/{{userId}}
Accept: {{json}}

### Full update (PUT) – supply all mutable fields (missing roles -> empty)
PUT {{base}}/users/{{userId}}
Content-Type: {{json}}
Accept: {{json}}

{
	"id": "{{userId}}",
	"login": "newuser1",
	"email": "newuser1.updated@example.com",
	"birthDate": "1998-05-21",
	"roles": ["USER","MODERATOR"]
}

### Partial update (PATCH) – only changed fields
PATCH {{base}}/users/{{userId}}
Content-Type: {{json}}
Accept: {{json}}

{
	"email": "newuser1.patched@example.com"
}

### Delete user
DELETE {{base}}/users/{{userId}}

### Verify deletion (should return 404)
GET {{base}}/users/{{userId}}
Accept: {{json}}

################################################################################
# Avatar (if avatar endpoints are later added to servlet; placeholders shown)
################################################################################
# NOTE:
# 1. Run a GET avatar early to see 404 before upload.
# 2. Provide a small PNG (<=200KB) at path referenced by @avatarFile.
# 3. Two upload variants are provided: raw binary and multipart.
################################################################################

@avatarFile = ./sample-avatar.png

### (Expect 404 if no avatar yet)
GET {{base}}/users/{{userId}}/avatar
Accept: image/png

### Upload avatar (raw binary PUT)
PUT {{base}}/users/{{userId}}/avatar
Content-Type: image/png

< C:\Users\stefa\IdeaProjects\firearm-collection-JEE\src\main\resources\avatars\avatar1.png

### Retrieve uploaded avatar (PNG bytes)
GET {{base}}/users/{{userId}}/avatar
Accept: image/png

### Delete avatar
DELETE {{base}}/users/{{userId}}/avatar

### Verify deletion (expect 404 again)
GET {{base}}/users/{{userId}}/avatar
Accept: image/png

### Negative: upload with wrong content type (expect 400)
PUT {{base}}/users/{{userId}}/avatar
Content-Type: text/plain

This is not an image.

### Negative: delete again (still 404)
DELETE {{base}}/users/{{userId}}/avatar

################################################################################
# Negative tests
################################################################################
### Create user with duplicate login (expect 400 after first create)
POST {{base}}/users
Content-Type: {{json}}
Accept: {{json}}

{
	"login": "admin",
	"email": "another-admin@example.com",
	"roles": ["ADMIN"]
}

### Create user with invalid email (expect 400)
POST {{base}}/users
Content-Type: {{json}}
Accept: {{json}}

{
	"login": "badmail",
	"email": "not-an-email",
	"roles": ["USER"]
}

