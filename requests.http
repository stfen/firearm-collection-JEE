@host = localhost:9080
@base = http://{{host}}/firearm-collection-JEE-1.0-SNAPSHOT/api
@json = application/json

################################################################################
# USER ENDPOINTS
################################################################################

### List all users
GET {{base}}/users
Accept: {{json}}

### Get user by UUID
@userId = 70b21553-3690-4464-97a3-4481ce862b28
GET {{base}}/users/{{userId}}
Accept: {{json}}

### Get user by login
GET {{base}}/users/login/seima
Accept: {{json}}

### Create user
PUT {{base}}/users/c461d210-8cea-4213-a19a-3cb856351d57
Content-Type: {{json}}

{
	"login": "newuser",
	"email": "newuser@example.com",
	"birthDate": "1998-05-21"
}

### Update user (PATCH)
PATCH {{base}}/users/{{userId}}
Content-Type: {{json}}

{
	"email": "updated@example.com"
}

### Upload avatar
PUT {{base}}/users/c461d210-8cea-4213-a19a-3cb856351d57/avatar
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< C:\Users\stefa\Pictures\Roblox\RobloxScreenShot20240923_224013968.png
--boundary--

### Get avatar
GET {{base}}/users/c461d210-8cea-4213-a19a-3cb856351d57/avatar
Accept: image/png

################################################################################
# WEAPON FAMILY ENDPOINTS
################################################################################

### List all weapon families
GET {{base}}/weaponfamilies
Accept: {{json}}

################################################################################
# FIREARM ENDPOINTS
################################################################################

### List all firearms
GET {{base}}/firearms
Accept: {{json}}

### Get specific firearm
@firearmId = 11111111-2222-3333-4444-555555555555
GET {{base}}/firearms/{{firearmId}}
Accept: {{json}}

### Create firearm
@newFirearmId = f1f1f1f1-2f2f-3f3f-4f4f-5f5f5f5f5e7f
PUT {{base}}/firearms/{{newFirearmId}}
Content-Type: {{json}}

{
	"name": "Test Rifle",
	"caliber": 7.62,
	"magazineCapacity": 20,
	"weaponFamilyId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
	"productionDate": "2020-01-15",
	"userId": "70b21512-1234-5678-97a3-4481ce862b26"
}

### Update firearm
PATCH {{base}}/firearms/{{firearmId}}
Content-Type: {{json}}

{
	"name": "Updated Test Rifle",
	"magazineCapacity": 25
}

### Delete firearm
DELETE {{base}}/firearms/{{firearmId}}

################################################################################
# RELATIONSHIP ENDPOINTS
################################################################################

### Get user's firearms
@user1Id = 70b21553-3690-4464-97a3-4481ce862b28
GET {{base}}/users/{{user1Id}}/firearms
Accept: {{json}}

### Get weapon family's firearms
@assaultRifleId = a1b2c3d4-e5f6-7890-abcd-ef1234567890
GET {{base}}/weaponfamilies/{{assaultRifleId}}/firearms
Accept: {{json}}
