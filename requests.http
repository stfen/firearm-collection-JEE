@host = localhost:9080
@base = http://{{host}}/firearm-collection-JEE/api
@json = application/json

### List all users
GET {{base}}/users
Accept: {{json}}

### Get user by UUID (replace {{userId}} after creation)
@userId = 70b21553-3690-4464-97a3-4481ce862b28
GET {{base}}/users/{{userId}}
Accept: {{json}}

### Get user by login
GET {{base}}/users/login/seima
Accept: {{json}}

### Create user (PUT)
PUT {{base}}/users/c461d210-8cea-4213-a19a-3cb856351d57
Content-Type: {{json}}

{
	"login": "newuser4",
	"email": "newuser4@example.com",
	"birthDate": "1998-05-21"
}

### Partial update (PATCH) – only changed fields
PATCH {{base}}/users/{{userId}}
Content-Type: {{json}}
Accept: {{json}}

{
	"email": "newuser1.patched@example.com"
}

### Delete user
DELETE {{base}}/users/{{userId}}

### (Expect 404 if no avatar yet)
GET {{base}}/users/{{userId}}/avatar
Accept: image/png

### Upload avatar (raw binary PUT)
PUT {{base}}/users/70b21553-3690-4464-97a3-4481ce862b28/avatar
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar1.png"
Content-Type: image/png

< C:\Users\stefa\Pictures\Roblox\RobloxScreenShot20240923_224013968.png
--boundary--

### Retrieve uploaded avatar (PNG bytes)
GET {{base}}/users/70b21553-3690-4464-97a3-4481ce862b28/avatar
Accept: image/png

### Delete avatar
DELETE {{base}}/users/{{userId}}/avatar

### Create user with invalid email (expect 400)
PUT {{base}}/users
Content-Type: {{json}}
Accept: {{json}}

{
	"login": "badmail",
	"email": "not-an-email",
	"roles": ["USER"]
}


